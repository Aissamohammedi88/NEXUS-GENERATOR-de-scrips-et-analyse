# CLIENT HTTP UNIVERSEL
# ═══════════════════════════════════════════════════════════════════════════
class HTTPClient:
def __init__(self, cache_ttl=3600):
self.cache = {}
self.cache_ttl = cache_ttl
self.lock = threading.Lock()

def _cache_key(self, url, method="GET", body=None):
raw = f"{method}:{url}:{body or ''}"
return hashlib.md5(raw.encode()).hexdigest()

def _ssl_ctx(self):
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
return ctx

def get(self, url, headers=None, timeout=10, use_cache=True):
if use_cache:
key = self._cache_key(url, "GET")
with self.lock:
entry = self.cache.get(key)
if entry and time.time() - entry["ts"] < self.cache_ttl:
return entry["data"]
h = {
"User-Agent": f"NexusGeneratorPro/{VERSION}",
"Accept": "application/json, text/html, */*",
}
if headers:
h.update(headers)
try:
req = urllib.request.Request(url, headers=h)
with urllib.request.urlopen(req, timeout=timeout, context=self._ssl_ctx()) as r:
data = r.read().decode("utf-8", errors="ignore")
if use_cache:
with self.lock:
self.cache[key] = {"data": data, "ts": time.time()}
return data
except urllib.error.HTTPError as e:
return f'{{"error": "HTTP {e.code}"}}'
except Exception as e:
return f'{{"error": "{str(e)[:100]}"}}'

def post_json(self, url, payload, headers=None, timeout=15):
h = {"User-Agent": f"NexusGeneratorPro/{VERSION}", "Content-Type": "application/json"}
if headers:
h.update(headers)
try:
data = json.dumps(payload).encode("utf-8")
req = urllib.request.Request(url, data=data, headers=h, method="POST")
with urllib.request.urlopen(req, timeout=timeout, context=self._ssl_ctx()) as r:
return r.read().decode("utf-8", errors="ignore")
except urllib.error.HTTPError as e:
try:
body = e.read().decode("utf-8", errors="ignore")
except Exception:
body = ""
return f'{{"error": "HTTP {e.code}", "body": "{body[:300]}"}}'
except Exception as e:
return f'{{"error": "{str(e)[:100]}"}}'

def get_json(self, url, headers=None, timeout=10, use_cache=True):
raw = self.get(url, headers, timeout, use_cache)
try:
return json.loads(raw)
except Exception:
return {"error": "invalid_json", "raw": raw[:300]}


HTTP = HTTPClient()


