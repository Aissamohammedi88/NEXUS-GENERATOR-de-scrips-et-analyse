# MOTEUR DE RECHERCHE MULTI-API
# ═══════════════════════════════════════════════════════════════════════════
class SearchEngine:
def __init__(self):
self.results = {}
self.stats = {}

def search_all(self, query):
start = time.time()
self.results = {}
keywords = self._extract_keywords(query)
tasks = {name: (lambda cls=cls: cls.search(keywords, limit=3))
for name, cls in ALL_APIS.items()}
with ThreadPoolExecutor(max_workers=12) as ex:
futures = {ex.submit(fn): name for name, fn in tasks.items()}
for fut in as_completed(futures):
name = futures[fut]
try:
self.results[name] = fut.result(timeout=15)
except Exception as e:
self.results[name] = {"error": str(e)[:100]}
self.stats = {
"duration_ms": int((time.time() - start) * 1000),
"sources": len(self.results),
"total_items": sum(len(v) if isinstance(v, list) else (1 if v else 0)
for v in self.results.values()),
}
return self.results

def _extract_keywords(self, query):
stop = {"le","la","les","un","une","des","de","du","et","ou","à","au","aux",
"en","pour","sur","dans","avec","cree","créer","fais","faire",
"generer","générer","moi","je","veux","peux","tu","svp","stp",
"please","script"}
words = re.findall(r"\b[a-zA-ZÀ-ÿ0-9]{3,}\b", query.lower())
filtered = [w for w in words if w not in stop]
return " ".join(filtered[:6]) if filtered else query

def get_context_summary(self):
ctx = []
for name, result in self.results.items():
if isinstance(result, list) and result:
ctx.append(f"\n📡 {name.upper()}:")
for item in result[:2]:
if isinstance(item, dict):
title = item.get("title") or item.get("name") or item.get("label") or "?"
ctx.append(f" • {str(title)[:100]}")
return "\n".join(ctx) if ctx else "Aucun contexte externe."


