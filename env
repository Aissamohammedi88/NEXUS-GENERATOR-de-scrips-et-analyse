h += '<div class="stat"><div class="stat-lbl">Extensions</div><div class="stat-val">' + d.extensions_totales + '</div></div>';
document.getElementById('stats').innerHTML = h;

if(d.recherche && d.recherche.stats){
var s = '<div class="source"><div class="source-lbl">Durée</div><div class="source-count">' + d.recherche.stats.duration_ms + ' ms</div></div>';
s += '<div class="source"><div class="source-lbl">Sources</div><div class="source-count">' + d.recherche.stats.sources + '</div></div>';
