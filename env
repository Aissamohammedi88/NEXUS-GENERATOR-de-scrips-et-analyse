# ═══════════════════════════════════════════════════════════════════════════
# HANDLER HTTP
# ═══════════════════════════════════════════════════════════════════════════
class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", "0"))
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
p = self.path.split("?")[0]
if p in ("/", "/index.html"):
html = (HTML_INDEX
.replace("__V__", VERSION)
.replace("__LANG__", str(len(LANGAGES)))
.replace("__EXT__", str(TOTAL_EXTENSIONS))
.replace("__API__", str(len(ALL_APIS)))
.replace("__LIC__", LICENCE))
return self._send(200, html.encode("utf-8"), "text/html")
if p == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "author": AUTEUR,
"apis": list(ALL_APIS.keys()),
"languages": list(LANGAGES.keys()),
"total_extensions": TOTAL_EXTENSIONS,
}).encode())
if p == "/api/languages":
return self._send(200, json.dumps({"languages": LANGAGES}).encode())
if p == "/api/apis":
return self._send(200, json.dumps({"apis": list(ALL_APIS.keys())}).encode())
if p == "/api/search":
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
query = qs.get("q", [""])[0]
if not query:
return self._send(400, b'{"error":"missing q"}')
engine = SearchEngine()
results = engine.search_all(query)
return self._send(200, json.dumps({
"query": query, "results": results,
"stats": engine.stats, "context": engine.get_context_summary(),
}, ensure_ascii=False, default=str).encode())
if p == "/api/files":
files = []
for nom in sorted(os.listdir(GENERATED), reverse=True)[:100]:
chemin = os.path.join(GENERATED, nom)
if os.path.isfile(chemin):
st = os.stat(chemin)
files.append({"nom": nom, "taille": st.st_size, "mtime": st.st_mtime})
return self._send(200, json.dumps({"files": files}).encode())
if p.startswith("/generated/"):
nom = os.path.basename(p[len("/generated/"):])
chemin = os.path.join(GENERATED, nom)
if not os.path.isfile(chemin) or not chemin.startswith(GENERATED):
return self._send(404, b'{"error":"not found"}')
with open(chemin, "rb") as f:
return self._send(200, f.read(), "text/plain; charset=utf-8")
return self._send(404, b'{"error":"not found"}')

def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()
if p == "/api/generate":
prompt = data.get("prompt", "").strip()
port = int(data.get("port", 8090))
save = bool(data.get("save", False))
use_search = bool(data.get("search", True))
if not prompt:
return self._send(400, json.dumps({"ok": False, "erreur": "prompt vide"}).encode())
try:
r = generer_script(prompt, port, use_search)
chemin = sauvegarder(r) if save else None
rep = dict(r)
rep["ok"] = True
if chemin:
rep["chemin"] = chemin
return self._send(200, json.dumps(rep, ensure_ascii=False, default=str).encode())
except Exception as e:
return self._send(500, json.dumps({"ok": False, "erreur": str(e)[:300]}).encode())
return self._send(404, b'{"error":"not found"}')


