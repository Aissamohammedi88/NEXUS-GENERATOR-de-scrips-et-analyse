def detecter_domaine(prompt):
p = prompt.lower()
scores = {d: sum(1 for m in c["mots"] if m in p) for d, c in DOMAINES.items()}
if max(scores.values()) == 0:
return "systeme", 0.3
best = max(scores, key=scores.get)
total = sum(scores.values())
return best, round(scores[best] / total if total else 0.3, 2)


