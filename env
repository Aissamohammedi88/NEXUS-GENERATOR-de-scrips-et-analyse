for entry in re.findall(r"<entry>(.*?)</entry>", raw, re.DOTALL)[:limit]:
t = re.search(r"<title>(.*?)</title>", entry, re.DOTALL)
l = re.search(r"<id>(.*?)</id>", entry, re.DOTALL)
if t:
results.append({"title": t.group(1).strip()[:150],
"url": l.group(1).strip() if l else ""})
return results


