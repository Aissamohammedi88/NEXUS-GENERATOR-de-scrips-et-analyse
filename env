def detecter_langage_par_extension(nom_fichier):
"""Détecte le langage d'un fichier par son extension."""
if not nom_fichier:
return None
base = nom_fichier.lower()
# Cas spéciaux sans extension
specials = {
"dockerfile": "dockerfile",
"makefile": "makefile",
"cmakelists.txt": "cmake",
"license": "license",
"licence": "license",
"copying": "license",
}
if base in specials:
return specials[base]
if base.startswith("readme"):
return "readme"
# Par extension
for ext, lang in EXT_TO_LANG.items():
if base.endswith(ext):
return lang
return None


