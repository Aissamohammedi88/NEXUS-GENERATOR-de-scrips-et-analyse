h1{font-size:clamp(22px,4vw,34px);font-weight:700;letter-spacing:-1.5px;background:linear-gradient(135deg,#c800ff,#00d4ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px}
.subtitle{color:#7a5a9a;font-size:12px;font-family:ui-monospace,monospace;margin-bottom:22px}
.panel{background:rgba(15,8,20,0.85);border:1px solid #3a1a4a;border-radius:14px;padding:22px;margin-bottom:16px}
.panel h2{color:#c800ff;font-size:12px;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid #3a1a4a}
.form-group{margin-bottom:14px}
.form-group label{display:block;font-size:11px;color:#7a5a9a;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.form-group textarea,.form-group input{width:100%;padding:12px 14px;background:rgba(0,0,0,0.5);border:1px solid #3a1a4a;border-radius:10px;color:#e0d0ff;font-size:14px;font-family:inherit;outline:none}
.form-group textarea:focus,.form-group input:focus{border-color:#c800ff}
.form-group textarea{min-height:90px;resize:vertical;font-family:ui-monospace,monospace;line-height:1.5}
.btn{background:linear-gradient(135deg,#c800ff,#00d4ff);color:#000;border:none;padding:13px 26px;border-radius:10px;font-weight:700;cursor:pointer;font-family:ui-monospace,monospace;font-size:13px;letter-spacing:1px;margin-right:8px;margin-bottom:8px}
.btn:hover{opacity:0.9}
.btn.sec{background:transparent;color:#c800ff;border:1px solid #c800ff}
.btn.sec:hover{background:rgba(200,0,255,0.1)}
.presets{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.preset{padding:6px 12px;background:rgba(200,0,255,0.1);border:1px solid #3a1a4a;color:#c800ff;border-radius:20px;font-size:11px;cursor:pointer;font-family:ui-monospace,monospace}
.preset:hover{background:rgba(200,0,255,0.2)}
.result{background:rgba(0,0,0,0.6);border:1px solid #3a1a4a;border-radius:10px;padding:16px;font-family:ui-monospace,monospace;font-size:12px;color:#00ffc8;white-space:pre-wrap;word-break:break-word;max-height:500px;overflow:auto;line-height:1.6;margin-top:14px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.stat{background:rgba(0,0,0,0.4);border:1px solid #3a1a4a;border-radius:8px;padding:10px 12px}
.stat-lbl{color:#7a5a9a;font-size:10px;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}
.stat-val{color:#c800ff;font-size:18px;font-weight:700;font-family:ui-monospace,monospace}
.list{background:rgba(0,0,0,0.3);border-radius:8px;padding:12px;max-height:300px;overflow:auto;font-family:ui-monospace,monospace;font-size:11px;color:#7a5a9a;line-height:1.8}
.list a{color:#00d4ff;text-decoration:none}
.list a:hover{color:#c800ff}
.footer{text-align:center;color:#3a2a4a;font-size:11px;margin-top:30px;font-family:ui-monospace,monospace}
.loader{text-align:center;padding:30px;color:#c800ff}
.spinner{display:inline-block;width:30px;height:30px;border:3px solid rgba(200,0,255,0.3);border-top-color:#c800ff;border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:10px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="container">
<h1>NEXUS GENERATOR</h1>
<div class="subtitle">Genere un script Python depuis un prompt - Aissa Mohammedi (DGK) - v__V__</div>

<div class="panel">
<h2>Prompt</h2>
<div class="presets">
<div class="preset" onclick="setPrompt('cree moi un script pour analyse pc')">Analyse PC</div>
<div class="preset" onclick="setPrompt('scanner mon reseau')">Scanner reseau</div>
<div class="preset" onclick="setPrompt('analyser mes fichiers')">Analyser fichiers</div>
<div class="preset" onclick="setPrompt('audit securite et certificats tls')">Audit securite</div>
<div class="preset" onclick="setPrompt('monitoring systeme en temps reel')">Monitoring</div>
<div class="preset" onclick="setPrompt('tableau de bord web pour suivre mes donnees')">Dashboard web</div>
</div>
<div class="form-group">
<label>Decris ce que tu veux</label>
<textarea id="prompt" placeholder="Ex: cree moi un script pour analyse pc">cree moi un script pour analyse pc</textarea>
</div>
<div class="form-group">
<label>Port du serveur genere</label>
<input type="number" id="port" value="8090" min="1024" max="65535">
</div>
<button class="btn" onclick="generer()">GENERER</button>
<button class="btn sec" onclick="genererEtSauver()">GENERER + SAUVEGARDER</button>
<button class="btn sec" onclick="voirFichiers()">VOIR FICHIERS</button>
</div>

<div class="panel" id="panel-result" style="display:none">
<h2>Resultat</h2>
<div class="stats" id="stats"></div>
<div class="result" id="result"></div>
</div>

<div class="panel" id="panel-fichiers" style="display:none">
<h2>Fichiers generes</h2>
<div class="list" id="fichiers"></div>
</div>

<div class="footer">NEXUS GENERATOR v__V__ - Aissa Mohammedi (DGK) - NEXUS-OPEN-2.0</div>
</div>

<script>
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

function setPrompt(p){
document.getElementById('prompt').value = p;
}

async function generer(){
var prompt = document.getElementById('prompt').value.trim();
if(!prompt){ alert('Ecris un prompt'); return; }
var port = parseInt(document.getElementById('port').value) || 8090;

var panel = document.getElementById('panel-result');
panel.style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Generation en cours...</div></div>';
document.getElementById('result').textContent = '';

try{
var r = await fetch('/api/generate', {
method:'POST',
headers:{'Content-Type':'application/json'},
body: JSON.stringify({prompt: prompt, port: port, save: false})
});
var d = await r.json();
if(d.ok){
afficherResultat(d);
} else {
document.getElementById('stats').innerHTML = '<div class="result">Erreur : ' + esc(d.erreur || '?') + '</div>';
}
}catch(e){
document.getElementById('stats').innerHTML = '<div class="result">Erreur reseau : ' + esc(e.message) + '</div>';
}
}

async function genererEtSauver(){
var prompt = document.getElementById('prompt').value.trim();
if(!prompt){ alert('Ecris un prompt'); return; }
var port = parseInt(document.getElementById('port').value) || 8090;

var panel = document.getElementById('panel-result');
panel.style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Generation + sauvegarde...</div></div>';

try{
var r = await fetch('/api/generate', {
method:'POST',
headers:{'Content-Type':'application/json'},
body: JSON.stringify({prompt: prompt, port: port, save: true})
});
var d = await r.json();
if(d.ok){
afficherResultat(d);
if(d.chemin){
alert('Sauvegarde dans : ' + d.chemin);
}
} else {
document.getElementById('stats').innerHTML = '<div class="result">Erreur : ' + esc(d.erreur || '?') + '</div>';
}
}catch(e){
document.getElementById('stats').innerHTML = '<div class="result">Erreur reseau : ' + esc(e.message) + '</div>';
}
}

function afficherResultat(d){
var html = '';
html += '<div class="stat"><div class="stat-lbl">Domaine</div><div class="stat-val">' + esc(d.domaine) + '</div></div>';
html += '<div class="stat"><div class="stat-lbl">Confiance</div><div class="stat-val">' + d.confiance_domaine + '</div></div>';
html += '<div class="stat"><div class="stat-lbl">Fiabilite</div><div class="stat-val">' + esc(d.fiabilite.niveau) + '</div></div>';
html += '<div class="stat"><div class="stat-lbl">Score</div><div class="stat-val">' + d.fiabilite.score + '/100</div></div>';
html += '<div class="stat"><div class="stat-lbl">Lignes</div><div class="stat-val">' + d.lignes + '</div></div>';
html += '<div class="stat"><div class="stat-lbl">Port</div><div class="stat-val">' + d.port + '</div></div>';
document.getElementById('stats').innerHTML = html;

var result = 'ACTIONS : ' + (d.actions.length ? d.actions.join(', ') : 'aucune') + '\\n\\n';
result += 'SYNTAXE : ' + (d.verification_syntaxe.ok ? 'OK' : 'KO') + '\\n';
result += 'IMPORTS : ' + (d.imports_non_stdlib.length ? d.imports_non_stdlib.join(', ') : 'tous stdlib') + '\\n';
result += 'HASH : ' + d.code_hash.substring(0, 24) + '...\\n\\n';
result += '=== CODE ===\\n\\n' + d.code;
document.getElementById('result').textContent = result;
}

async function voirFichiers(){
var panel = document.getElementById('panel-fichiers');
panel.style.display = 'block';
try{
var r = await fetch('/api/files');
var d = await r.json();
var html = '';
if(!d.files || !d.files.length){
html = 'Aucun fichier genere pour le moment.';
} else {
d.files.forEach(function(f){
html += '<div><a href="/generated/' + esc(f.nom) + '" target="_blank">' + esc(f.nom) + '</a> — ' + f.taille + ' o — ' + new Date(f.mtime * 1000).toLocaleString() + '</div>';
});
}
document.getElementById('fichiers').innerHTML = html;
}catch(e){
document.getElementById('fichiers').innerHTML = 'Erreur : ' + esc(e.message);
}
}
</script>
</body>
</html>"""


class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self):
try:
length = int(self.headers.get("Content-Length", "0"))
body = self.rfile.read(length).decode("utf-8")
return json.loads(body)
except Exception:
return {}

def do_GET(self):
p = self.path.split("?")[0]
if p in ("/", "/index.html"):
html = HTML_INDEX.replace("__V__", VERSION)
return self._send(200, html.encode("utf-8"), "text/html")
if p == "/api/health":
return self._send(200, b'{"ok":true}')
if p == "/api/files":
fichiers = []
if os.path.isdir(GENERATED):
for nom in sorted(os.listdir(GENERATED), reverse=True):
chemin = os.path.join(GENERATED, nom)
if os.path.isfile(chemin):
try:
st = os.stat(chemin)
fichiers.append({"nom": nom, "taille": st.st_size, "mtime": st.st_mtime})
except OSError:
pass
return self._send(200, json.dumps({"files": fichiers[:100]}, ensure_ascii=False).encode())
if p.startswith("/generated/"):
nom = os.path.basename(p[len("/generated/"):])
chemin = os.path.join(GENERATED, nom)
if not os.path.isfile(chemin) or not chemin.startswith(GENERATED):
return self._send(404, b'{"erreur":"not found"}')
try:
with open(chemin, "rb") as f:
data = f.read()
return self._send(200, data, "text/plain; charset=utf-8")
except OSError:
return self._send(500, b'{"erreur":"read error"}')
return self._send(404, b'{"erreur":"not found"}')

def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()
if p == "/api/generate":
prompt = data.get("prompt", "").strip()
port = int(data.get("port", 8090))
save = bool(data.get("save", False))
if not prompt:
return self._send(400, json.dumps({"ok": False, "erreur": "prompt vide"}).encode())
try:
r = generer_script(prompt, port)
chemin = None
if save:
chemin = sauvegarder(r)
reponse = dict(r)
reponse["ok"] = True
if chemin:
reponse["chemin"] = chemin
return self._send(200, json.dumps(reponse, ensure_ascii=False, default=str).encode())
except Exception as e:
return self._send(500, json.dumps({"ok": False, "erreur": str(e)[:200]}).encode())
return self._send(404, b'{"erreur":"not found"}')


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


def main():
print("=" * 70)
print("NEXUS GENERATOR RUNNER v" + VERSION)
print("Auteur : " + AUTEUR)
print("Licence : " + LICENCE)
print("=" * 70)
print("")
print("Dossier : " + BASE)
print("Generes : " + GENERATED)
print("")
ip = ip_locale()
print("Local : http://localhost:" + str(PORT) + "/")
print("Reseau : http://" + ip + ":" + str(PORT) + "/")
print("")
print("Ouvre Safari sur l'URL, ecris un prompt, clique GENERER.")
print("")
print("Ctrl+C pour arreter")
print("")
try:
with Server(("0.0.0.0", PORT), Handler) as httpd:
httpd.serve_forever()
except KeyboardInterrupt:
print("")
print("Arrete.")


if __name__ == "__main__":
main()
