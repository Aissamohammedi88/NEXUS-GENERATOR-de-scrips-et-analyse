def log(msg):
ts = time.strftime("%Y-%m-%d %H:%M:%S")
try:
print("[" + ts + "] " + str(msg), flush=True)
except Exception:
pass


def ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "localhost"


def detecter_domaine(prompt):
p = prompt.lower()
scores = {}
for domaine, config in DOMAINES.items():
score = sum(1 for mot in config["mots"] if mot in p)
scores[domaine] = score
if max(scores.values()) == 0:
return "systeme", 0.3
meilleur = max(scores, key=scores.get)
total = sum(scores.values())
confiance = scores[meilleur] / total if total > 0 else 0.3
return meilleur, round(confiance, 2)


def detecter_actions(prompt):
p = prompt.lower()
actions = []
for action, mots in ACTIONS.items():
if any(mot in p for mot in mots):
actions.append(action)
return actions


def evaluer_fiabilite(prompt, domaine, actions, confiance):
score = 0
raisons = []
if len(prompt) > 40:
score += 20
raisons.append("+20 prompt detaille")
elif len(prompt) > 15:
score += 10
raisons.append("+10 prompt moyen")
else:
score -= 10
raisons.append("-10 prompt trop court")
if confiance > 0.6:
score += 25
raisons.append("+25 domaine clair")
elif confiance > 0.4:
score += 15
raisons.append("+15 domaine identifiable")
else:
score -= 10
raisons.append("-10 domaine ambigu")
if len(actions) >= 2:
score += 20
raisons.append("+20 actions multiples")
elif len(actions) == 1:
score += 10
raisons.append("+10 une action")
else:
score -= 5
raisons.append("-5 aucune action")
score += 15
raisons.append("+15 domaine connu")
score = max(0, min(100, score))
if score >= 80:
niveau = "ELEVEE"
elif score >= 60:
niveau = "MOYENNE"
elif score >= 40:
niveau = "FAIBLE"
else:
niveau = "BASSE"
return {"score": score, "niveau": niveau, "raisons": raisons}


def generer_entete(prompt, domaine, port):
ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
h = hashlib.sha256(prompt.encode()).hexdigest()[:12]
return (
"#!/usr/bin/env python3\n"
"# -*- coding: utf-8 -*-\n"
"# NEXUS GENERATED SCRIPT\n"
"# Auteur : " + AUTEUR + "\n"
"# Licence : " + LICENCE + "\n"
"# Domaine : " + domaine + "\n"
"# Prompt : " + prompt[:180].replace("\n", " ") + "\n"
"# Hash : " + h + "\n"
"# Date : " + ts + "\n"
"# Port : " + str(port) + "\n"
"\n"
)


def generer_imports(domaine):
base = [
"import os",
"import sys",
"import json",
"import time",
"import socket",
"import threading",
"import datetime",
"from http.server import BaseHTTPRequestHandler, HTTPServer",
"from socketserver import ThreadingMixIn",
]
config = DOMAINES.get(domaine, DOMAINES["systeme"])
extras = []
for imp in config["imports"]:
if imp in ("os", "sys", "json", "time", "socket", "threading", "datetime"):
continue
if imp == "urllib.request":
extras.append("import urllib.request")
elif imp == "urllib.parse":
extras.append("import urllib.parse")
else:
extras.append("import " + imp)
tous = base + extras
return "\n".join(sorted(set(tous))) + "\n\n"


def bloc_collecte_systeme():
return textwrap.dedent('''
def collecter_systeme():
resultat = {
"timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"hostname": socket.gethostname(),
"pid": os.getpid(),
"cwd": os.getcwd(),
"home": os.path.expanduser("~"),
"cpu_count": os.cpu_count() or 0,
"python": sys.version.split()[0],
}
try:
import platform
resultat["plateforme"] = platform.platform()
resultat["machine"] = platform.machine()
resultat["systeme"] = platform.system()
except Exception:
resultat["plateforme"] = "inconnu"
try:
with open("/proc/meminfo") as f:
mem = {}
for line in f:
if ":" in line:
k, v = line.split(":", 1)
mem[k.strip()] = v.strip()
total_kb = int(mem.get("MemTotal", "0").split()[0])
avail_kb = int(mem.get("MemAvailable", "0").split()[0])
resultat["memoire_total_mo"] = round(total_kb / 1024, 2)
resultat["memoire_libre_mo"] = round(avail_kb / 1024, 2)
if total_kb > 0:
resultat["memoire_utilisee_pct"] = round((total_kb - avail_kb) / total_kb * 100, 2)
except Exception:
resultat["memoire_total_mo"] = None
try:
import shutil
total, used, free = shutil.disk_usage("/")
resultat["disque_total_go"] = round(total / (1024 ** 3), 2)
resultat["disque_libre_go"] = round(free / (1024 ** 3), 2)
resultat["disque_utilise_pct"] = round(used / total * 100, 2)
except Exception:
resultat["disque_total_go"] = None
try:
with open("/proc/loadavg") as f:
parts = f.read().split()
resultat["load_1min"] = float(parts[0])
resultat["load_5min"] = float(parts[1])
resultat["load_15min"] = float(parts[2])
except Exception:
resultat["load_1min"] = None
try:
with open("/proc/uptime") as f:
resultat["uptime_s"] = int(float(f.read().split()[0]))
except Exception:
resultat["uptime_s"] = None
return resultat
''').strip()


def bloc_collecte_reseau():
return textwrap.dedent('''
def tester_tcp(host, port, timeout=5):
try:
t0 = time.time()
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(timeout)
s.connect((host, port))
dt = round((time.time() - t0) * 1000, 2)
s.close()
return {"host": host, "port": port, "ok": True, "temps_ms": dt}
except Exception as e:
return {"host": host, "port": port, "ok": False, "erreur": str(e)[:100]}


def resoudre_dns(host):
try:
ip = socket.gethostbyname(host)
return {"host": host, "ip": ip, "ok": True}
except Exception as e:
return {"host": host, "ip": None, "ok": False, "erreur": str(e)[:100]}


def collecter_reseau():
cibles = [
("cloudflare-dns", "1.1.1.1", 53),
("google-dns", "8.8.8.8", 53),
("github", "github.com", 443),
("google", "google.com", 443),
]
resultats = []
for nom, host, port in cibles:
if host.replace(".", "").isdigit():
dns = {"host": host, "ip": host, "ok": True}
else:
dns = resoudre_dns(host)
tcp = tester_tcp(host, port)
resultats.append({"nom": nom, "dns": dns, "tcp": tcp})
return resultats
''').strip()


def bloc_collecte_fichier():
return textwrap.dedent('''
def collecter_fichiers(chemin=None):
if chemin is None:
chemin = os.path.expanduser("~")
resultat = {
"chemin": chemin,
"existe": os.path.isdir(chemin),
"total_fichiers": 0,
"total_dossiers": 0,
"total_octets": 0,
"par_extension": {},
"plus_gros": [],
}
if not resultat["existe"]:
return resultat
fichiers = []
for root, dirs, files in os.walk(chemin):
resultat["total_dossiers"] += len(dirs)
for f in files:
full = os.path.join(root, f)
try:
taille = os.path.getsize(full)
except OSError:
continue
ext = os.path.splitext(f)[1].lower() or "(sans)"
resultat["total_fichiers"] += 1
resultat["total_octets"] += taille
resultat["par_extension"][ext] = resultat["par_extension"].get(ext, 0) + 1
fichiers.append((full, taille))
fichiers.sort(key=lambda x: -x[1])
resultat["plus_gros"] = [{"chemin": p, "taille": t} for p, t in fichiers[:10]]
return resultat
''').strip()


def bloc_collecte_web():
return textwrap.dedent('''
def collecter_web():
resultat = {
"timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"hostname": socket.gethostname(),
"port": PORT,
"uptime_s": 0,
}
try:
with open("/proc/uptime") as f:
resultat["uptime_s"] = int(float(f.read().split()[0]))
except Exception:
pass
return resultat
''').strip()


def bloc_collecte_donnees():
return textwrap.dedent('''
def collecter_donnees(chemin=None):
resultat = {"chemin": chemin, "existe": False, "type": None, "taille": 0}
if not chemin or not os.path.isfile(chemin):
return resultat
resultat["existe"] = True
resultat["taille"] = os.path.getsize(chemin)
if chemin.endswith(".json"):
resultat["type"] = "json"
try:
with open(chemin, "r", encoding="utf-8") as f:
data = json.load(f)
if isinstance(data, list):
resultat["elements"] = len(data)
elif isinstance(data, dict):
resultat["cles"] = list(data.keys())[:20]
except Exception as e:
resultat["erreur"] = str(e)[:100]
elif chemin.endswith(".csv"):
resultat["type"] = "csv"
try:
import csv
with open(chemin, "r", encoding="utf-8") as f:
reader = csv.reader(f)
rows = list(reader)
resultat["lignes"] = len(rows)
if rows:
resultat["colonnes"] = rows[0]
except Exception as e:
resultat["erreur"] = str(e)[:100]
return resultat
''').strip()


def bloc_collecte_securite():
return textwrap.dedent('''
def collecter_securite():
resultat = {
"timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"hostname": socket.gethostname(),
}
try:
import ssl
import hashlib as _h
ctx = ssl.create_default_context()
with socket.create_connection(("www.google.com", 443), timeout=10) as sock:
with ctx.wrap_socket(sock, server_hostname="www.google.com") as ssock:
der = ssock.getpeercert(binary_form=True)
resultat["tls_test"] = {
"host": "www.google.com",
"version": ssock.version(),
"sha256": _h.sha256(der).hexdigest() if der else None,
}
except Exception as e:
resultat["tls_test"] = {"erreur": str(e)[:100]}
try:
import secrets
resultat["token_exemple"] = secrets.token_hex(16)
except Exception:
resultat["token_exemple"] = None
return resultat
''').strip()


COLLECTES = {
"systeme": bloc_collecte_systeme,
"reseau": bloc_collecte_reseau,
"fichier": bloc_collecte_fichier,
"web": bloc_collecte_web,
"donnees": bloc_collecte_donnees,
"securite": bloc_collecte_securite,
}

COLLECTE_FONCTION = {
"systeme": "collecter_systeme()",
"reseau": "collecter_reseau()",
"fichier": "collecter_fichiers()",
"web": "collecter_web()",
"donnees": "collecter_donnees()",
"securite": "collecter_securite()",
}


