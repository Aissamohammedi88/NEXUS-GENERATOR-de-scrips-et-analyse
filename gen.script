html = html.replace("__LICENCE__", licence)
html = html.replace("__PORT__", str(port))
return html


def generer_serveur_code():
return textwrap.dedent('''

class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def do_GET(self):
p = self.path.split("?")[0]
if p in ("/", "/index.html"):
return self._send(200, HTML_PAGE.encode("utf-8"), "text/html")
if p == "/api/collecter":
try:
data = collecter()
return self._send(200, json.dumps(data, ensure_ascii=False, default=str).encode())
except Exception as e:
return self._send(500, json.dumps({"erreur": str(e)[:200]}).encode())
if p == "/api/health":
return self._send(200, b'{"ok":true}')
return self._send(404, b'{"erreur":"not found"}')


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True
''').strip()


def generer_main_code():
return textwrap.dedent('''

def lancer_serveur(port=PORT):
print("=" * 60)
print("NEXUS GENERATED - " + DOMAINE)
print("=" * 60)
print("Port : " + str(port))
print("Local : http://localhost:" + str(port) + "/")
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
print("Reseau : http://" + ip + ":" + str(port) + "/")
except Exception:
pass
print("")
print("Ctrl+C pour arreter")
print("")
try:
with Server(("0.0.0.0", port), Handler) as httpd:
httpd.serve_forever()
except KeyboardInterrupt:
print("")
print("Arrete.")


def main():
import argparse
p = argparse.ArgumentParser()
p.add_argument("--port", type=int, default=PORT)
p.add_argument("--cli", action="store_true", help="Mode CLI sans serveur")
a = p.parse_args()
if a.cli:
data = collecter()
print(json.dumps(data, indent=2, ensure_ascii=False, default=str))
return
lancer_serveur(a.port)


if __name__ == "__main__":
main()
''').strip()


def verifier_syntaxe(code):
try:
ast.parse(code)
return {"ok": True, "erreur": None}
except SyntaxError as e:
return {"ok": False, "erreur": "ligne " + str(e.lineno) + " : " + str(e.msg)}


def verifier_imports(code):
stdlib = {
"os", "sys", "json", "time", "re", "ast", "hashlib", "hmac",
"secrets", "ssl", "socket", "urllib", "http", "socketserver",
"subprocess", "threading", "platform", "shutil", "pathlib",
"datetime", "csv", "collections", "statistics", "argparse",
"textwrap", "base64", "gzip", "sqlite3", "random", "string",
"uuid", "tempfile", "io", "pickle", "math",
}
importes = set()
for m in re.findall(r"^\s*(?:from\s+([a-zA-Z0-9_.]+)\s+import|import\s+([a-zA-Z0-9_.]+))", code, re.M):
nom = m[0] or m[1]
base = nom.split(".")[0]
if base:
importes.add(base)
return [i for i in importes if i not in stdlib]


def generer_script(prompt, port):
domaine, confiance = detecter_domaine(prompt)
actions = detecter_actions(prompt)
fiabilite = evaluer_fiabilite(prompt, domaine, actions, confiance)

entete = generer_entete(prompt, domaine, port)
imports = generer_imports(domaine)
bloc_collecte = COLLECTES.get(domaine, bloc_collecte_systeme)()
bloc_collecter = "def collecter():\n return " + COLLECTE_FONCTION.get(domaine, "collecter_systeme()") + "\n"
html_dash = generer_html_dashboard(domaine, port, VERSION, LICENCE)
bloc_html = 'HTML_PAGE = """' + html_dash + '"""'
bloc_serveur = generer_serveur_code()
bloc_main = generer_main_code()

code = (
entete
+ imports
+ "\nPORT = " + str(port) + "\n"
+ "DOMAINE = \"" + domaine + "\"\n"
+ "LICENCE = \"" + LICENCE + "\"\n\n"
+ bloc_collecte + "\n\n"
+ bloc_collecter + "\n\n"
+ bloc_html + "\n\n\n"
+ bloc_serveur + "\n\n\n"
+ bloc_main + "\n"
)

verif = verifier_syntaxe(code)
non_stdlib = verifier_imports(code)
code_hash = hashlib.sha256(code.encode()).hexdigest()

return {
"prompt": prompt,
"domaine": domaine,
"confiance_domaine": confiance,
"actions": actions,
"fiabilite": fiabilite,
"code": code,
"code_hash": code_hash,
"port": port,
"verification_syntaxe": verif,
"imports_non_stdlib": non_stdlib,
"lignes": code.count("\n"),
"octets": len(code.encode()),
}


def sauvegarder(r):
ts = int(time.time())
h = r["code_hash"][:8]
nom = "nexus_gen_" + str(ts) + "_" + h + ".py"
chemin = os.path.join(GENERATED, nom)
with open(chemin, "w", encoding="utf-8") as f:
f.write(r["code"])
rapport = os.path.join(GENERATED, "nexus_gen_" + str(ts) + "_" + h + ".json")
with open(rapport, "w", encoding="utf-8") as f:
json.dump(r, f, indent=2, ensure_ascii=False, default=str)
return chemin


HTML_INDEX = """<!DOCTYPE html>
