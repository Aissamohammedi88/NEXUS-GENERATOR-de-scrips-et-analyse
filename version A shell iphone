class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self):
try:
length = int(self.headers.get("Content-Length", "0"))
body = self.rfile.read(length).decode("utf-8")
return json.loads(body)
except Exception:
return {}

def do_GET(self):
p = self.path.split("?")[0]
if p in ("/", "/index.html"):
html = HTML_INDEX.replace("__V__", VERSION)
return self._send(200, html.encode("utf-8"), "text/html")
if p == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "author": AUTEUR,
"apis": ["pypi", "duckduckgo", "stackoverflow", "github",
"npm", "wikipedia", "salestore"],
}).encode())
if p == "/api/search":
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
query = qs.get("q", [""])[0]
if not query:
return self._send(400, b'{"error":"missing q"}')
engine = SearchEngine()
results = engine.search_all(query)
return self._send(200, json.dumps({
"query": query,
"results": results,
"stats": engine.stats,
"context": engine.get_context_summary(),
}, ensure_ascii=False, default=str).encode())
if p == "/api/salestore/ping":
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
shop = qs.get("shop", ["demo.myshopify.com"])[0]
result = SalestoreSearch.ping(shop)
return self._send(200, json.dumps(result, ensure_ascii=False).encode())
if p == "/api/files":
fichiers = []
if os.path.isdir(GENERATED):
for nom in sorted(os.listdir(GENERATED), reverse=True):
chemin = os.path.join(GENERATED, nom)
if os.path.isfile(chemin):
try:
st = os.stat(chemin)
fichiers.append({"nom": nom, "taille": st.st_size, "mtime": st.st_mtime})
except OSError:
pass
return self._send(200, json.dumps({"files": fichiers[:100]}, ensure_ascii=False).encode())
if p.startswith("/generated/"):
nom = os.path.basename(p[len("/generated/"):])
chemin = os.path.join(GENERATED, nom)
if not os.path.isfile(chemin) or not chemin.startswith(GENERATED):
return self._send(404, b'{"erreur":"not found"}')
try:
with open(chemin, "rb") as f:
data = f.read()
return self._send(200, data, "text/plain; charset=utf-8")
except OSError:
return self._send(500, b'{"erreur":"read error"}')
return self._send(404, b'{"erreur":"not found"}')

def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()
if p == "/api/generate":
prompt = data.get("prompt", "").strip()
port = int(data.get("port", 8090))
save = bool(data.get("save", False))
use_search = bool(data.get("search", True))
if not prompt:
return self._send(400, json.dumps({"ok": False, "erreur": "prompt vide"}).encode())
try:
r = generer_script(prompt, port, use_search)
chemin = None
if save:
chemin = sauvegarder(r)
reponse = dict(r)
reponse["ok"] = True
if chemin:
reponse["chemin"] = chemin
return self._send(200, json.dumps(reponse, ensure_ascii=False, default=str).encode())
except Exception as e:
import traceback
return self._send(500, json.dumps({
"ok": False,
"erreur": str(e)[:300],
"trace": traceback.format_exc()[:500]
}).encode())
if p == "/api/salestore/sync":
shop = data.get("shop", "").strip()
products = data.get("products", [])
if not shop or not isinstance(products, list):
return self._send(400, json.dumps({"ok": False, "erreur": "shop et products requis"}).encode())
try:
result = SalestoreSearch.sync_products(shop, products)
return self._send(200, json.dumps(result, ensure_ascii=False).encode())
except Exception as e:
return self._send(500, json.dumps({"ok": False, "erreur": str(e)[:200]}).encode())
return self._send(404, b'{"erreur":"not found"}')


