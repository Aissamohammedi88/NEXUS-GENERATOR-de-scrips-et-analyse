def detecter_domaine(prompt):
p = prompt.lower()
scores = {}
for domaine, config in DOMAINES.items():
score = sum(1 for mot in config["mots"] if mot in p)
scores[domaine] = score
if max(scores.values()) == 0:
return "systeme", 0.3
meilleur = max(scores, key=scores.get)
total = sum(scores.values())
confiance = scores[meilleur] / total if total > 0 else 0.3
return meilleur, round(confiance, 2)


def detecter_actions(prompt):
p = prompt.lower()
actions = []
for action, mots in ACTIONS.items():
if any(mot in p for mot in mots):
actions.append(action)
return actions


def evaluer_fiabilite(prompt, domaine, actions, confiance, search_engine):
score = 0
raisons = []

if len(prompt) > 40:
score += 20
raisons.append("+20 prompt détaillé")
elif len(prompt) > 15:
score += 10
raisons.append("+10 prompt moyen")
else:
score -= 10
raisons.append("-10 prompt trop court")

if confiance > 0.6:
score += 25
raisons.append("+25 domaine clair")
elif confiance > 0.4:
score += 15
raisons.append("+15 domaine identifiable")
else:
score -= 10
raisons.append("-10 domaine ambigu")

if len(actions) >= 2:
score += 20
raisons.append("+20 actions multiples")
elif len(actions) == 1:
score += 10
raisons.append("+10 une action")
else:
score -= 5
raisons.append("-5 aucune action")

if search_engine and search_engine.stats.get("total_items", 0) > 10:
score += 20
raisons.append("+20 contexte externe riche")
elif search_engine and search_engine.stats.get("total_items", 0) > 3:
score += 10
raisons.append("+10 contexte externe")

score = max(0, min(100, score))
if score >= 80:
niveau = "ELEVEE"
elif score >= 60:
niveau = "MOYENNE"
elif score >= 40:
niveau = "FAIBLE"
else:
niveau = "BASSE"
return {"score": score, "niveau": niveau, "raisons": raisons}


