class SearchEngine:
def __init__(self):
self.results = {}
self.stats = {}

def search_all(self, query):
start = time.time()
self.results = {}
keywords = self._extract_keywords(query)

tasks = {
"pypi": lambda: PyPISearch.search(keywords),
"duckduckgo": lambda: DuckDuckGoSearch.search(keywords, limit=5),
"duckduckgo_ia": lambda: DuckDuckGoSearch.instant_answer(keywords),
"stackoverflow": lambda: StackOverflowSearch.search(keywords, limit=5),
"github": lambda: GitHubSearch.search_repos(keywords, limit=5),
"npm": lambda: NPMSearch.search(keywords, limit=5),
"wikipedia": lambda: WikipediaSearch.search(keywords, limit=3),
"salestore": lambda: SalestoreSearch.search(keywords, limit=5),
}

with ThreadPoolExecutor(max_workers=8) as ex:
futures = {ex.submit(fn): name for name, fn in tasks.items()}
for fut in as_completed(futures):
name = futures[fut]
try:
self.results[name] = fut.result(timeout=15)
except Exception as e:
self.results[name] = {"error": str(e)[:100]}

self.stats = {
"duration_ms": int((time.time() - start) * 1000),
"sources": len(self.results),
"total_items": sum(
len(v) if isinstance(v, list) else (1 if v else 0)
for v in self.results.values()
),
}
return self.results

def _extract_keywords(self, query):
stop_words = {
"le", "la", "les", "un", "une", "des", "de", "du", "et",
"ou", "à", "au", "aux", "en", "pour", "sur", "dans", "avec",
"cree", "créer", "fais", "faire", "generer", "générer", "moi",
"je", "veux", "peux", "tu", "svp", "stp", "please", "script",
}
words = re.findall(r"\b[a-zA-ZÀ-ÿ0-9]{3,}\b", query.lower())
filtered = [w for w in words if w not in stop_words]
return " ".join(filtered[:6]) if filtered else query

def get_context_summary(self):
context = []
if isinstance(self.results.get("pypi"), list) and self.results["pypi"]:
context.append("📦 PACKAGES PYPI:")
for p in self.results["pypi"][:3]:
