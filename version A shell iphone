# API 2 — DuckDuckGo
# ═══════════════════════════════════════════════════════════════════════════
class DuckDuckGoSearch:
@staticmethod
def search(query, limit=5):
url = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote(query)}"
raw = HTTP.get(url, timeout=12, use_cache=False)
if raw.startswith('{"error"'):
return []
results = []
pattern = r'<a rel="nofollow" class="result__a" href="([^"]+)">([^<]+)</a>'
matches = re.findall(pattern, raw)
for url, title in matches[:limit]:
if "uddg=" in url:
try:
parsed = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
url = parsed.get("uddg", [url])[0]
except Exception:
pass
results.append({
"title": re.sub(r"<[^>]+>", "", title)[:150],
"url": url,
"source": "duckduckgo",
})
if not results:
pattern2 = r'href="(https?://[^"]+)"[^>]*>([^<]{10,150})</a>'
matches2 = re.findall(pattern2, raw)
for url, title in matches2[:limit]:
if "duckduckgo.com" in url:
continue
results.append({
"title": re.sub(r"<[^>]+>", "", title)[:150],
"url": url,
"source": "duckduckgo",
})
return results

@staticmethod
def instant_answer(query):
url = f"https://api.duckduckgo.com/?q={urllib.parse.quote(query)}&format=json&no_html=1"
data = HTTP.get_json(url, timeout=8)
if not data or "error" in data:
return None
result = {
"abstract": data.get("AbstractText", ""),
"abstract_url": data.get("AbstractURL", ""),
"abstract_source": data.get("AbstractSource", ""),
"answer": data.get("Answer", ""),
"answer_type": data.get("AnswerType", ""),
"definition": data.get("Definition", ""),
"definition_source": data.get("DefinitionSource", ""),
"related_topics": [
{"text": t.get("Text", "")[:150], "url": t.get("FirstURL", "")}
for t in data.get("RelatedTopics", [])[:5]
if isinstance(t, dict) and "Text" in t
],
}
if not any([result["abstract"], result["answer"], result["definition"]]):
return None
return result


