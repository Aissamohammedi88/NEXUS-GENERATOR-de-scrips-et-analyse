# API 3 — StackOverflow
# ═══════════════════════════════════════════════════════════════════════════
class StackOverflowSearch:
@staticmethod
def search(query, limit=5):
url = (
f"https://api.stackexchange.com/2.3/search/advanced"
f"?order=desc&sort=relevance"
f"&q={urllib.parse.quote(query)}"
f"&site=stackoverflow"
f"&pagesize={limit}"
f"&filter=withbody"
)
data = HTTP.get_json(url, timeout=10)
if not data or "items" not in data:
return []
results = []
for item in data["items"][:limit]:
body = item.get("body", "")
code_blocks = re.findall(r"<code>(.*?)</code>", body, re.DOTALL)
clean_body = re.sub(r"<[^>]+>", "", body)[:500]
results.append({
"title": item.get("title", ""),
"url": item.get("link", ""),
"score": item.get("score", 0),
"answered": item.get("is_answered", False),
"views": item.get("view_count", 0),
"tags": item.get("tags", [])[:5],
"excerpt": clean_body.strip(),
"code_samples": [c[:300] for c in code_blocks[:2]],
})
return results


