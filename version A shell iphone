return {"ok": False, "erreur": "ligne " + str(e.lineno) + " : " + str(e.msg)}


def verifier_imports(code):
stdlib = {
"os", "sys", "json", "time", "re", "ast", "hashlib", "hmac",
"secrets", "ssl", "socket", "urllib", "http", "socketserver",
"subprocess", "threading", "platform", "shutil", "pathlib",
"datetime", "csv", "collections", "statistics", "argparse",
"textwrap", "base64", "gzip", "sqlite3", "random", "string",
"uuid", "tempfile", "io", "pickle", "math",
}
importes = set()
for m in re.findall(r"^\s*(?:from\s+([a-zA-Z0-9_.]+)\s+import|import\s+([a-zA-Z0-9_.]+))", code, re.M):
nom = m[0] or m[1]
base = nom.split(".")[0]
if base:
importes.add(base)
return [i for i in importes if i not in stdlib]


def generer_script(prompt, port, use_search=True):
domaine, confiance = detecter_domaine(prompt)
actions = detecter_actions(prompt)

search_engine = None
if use_search:
search_engine = SearchEngine()
search_engine.search_all(prompt)

fiabilite = evaluer_fiabilite(prompt, domaine, actions, confiance, search_engine)

entete = generer_entete(prompt, domaine, port, search_engine)
imports = generer_imports(domaine)
bloc_collecte = COLLECTES.get(domaine, bloc_collecte_systeme)()
bloc_collecter = "def collecter():\n return " + COLLECTE_FONCTION.get(domaine, "collecter_systeme()") + "\n"
html_dash = generer_html_dashboard(domaine, port, VERSION, LICENCE)
bloc_html = 'HTML_PAGE = """' + html_dash + '"""'
bloc_serveur = generer_serveur_code()
bloc_main = generer_main_code()

code = (
entete
+ imports
+ "\nPORT = " + str(port) + "\n"
+ "DOMAINE = \"" + domaine + "\"\n"
+ "LICENCE = \"" + LICENCE + "\"\n\n"
+ bloc_collecte + "\n\n"
+ bloc_collecter + "\n\n"
+ bloc_html + "\n\n\n"
+ bloc_serveur + "\n\n\n"
+ bloc_main + "\n"
)

verif = verifier_syntaxe(code)
non_stdlib = verifier_imports(code)
code_hash = hashlib.sha256(code.encode()).hexdigest()

return {
"prompt": prompt,
"domaine": domaine,
"confiance_domaine": confiance,
"actions": actions,
"fiabilite": fiabilite,
"code": code,
"code_hash": code_hash,
