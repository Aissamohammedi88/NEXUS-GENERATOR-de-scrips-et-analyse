headers=headers, timeout=20)
try:
data = json.loads(raw)
except Exception:
data = {"raw": raw[:500]}
return {
"endpoint": SalestoreSearch.ENDPOINT,
"shop": shop,
"count": len(payload["products"]),
"response": data,
}

