for s in self.results["stackoverflow"][:3]:
context.append(f" • {s.get('title', '')[:100]}")
if s.get("code_samples"):
for code in s["code_samples"][:1]:
context.append(f" Code: {code[:150]}...")
if isinstance(self.results.get("github"), list) and self.results["github"]:
